[Unit]
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/reacthome-flow
ExecStartPre=/bin/sh -c 'until [ -e /sys/class/drm/card0-HDMI-A-2/status ] && [ "$(cat /sys/class/drm/card0-HDMI-A-2/status)" = "connected" ]; do sleep 1; done'
ExecStart=/home/pi/reacthome-flow/flow -s 2 -v -b .
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
