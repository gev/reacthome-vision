(module main
    (export main)

    (import screen.home)
    (import screen.homes)
    (import screen.add-home)
    (import screen.edit-home)
    (import screen.discovery)

    (def (home-route args)
        (route
            :screen (home-screen args)
        )
    )

    (def (homes-route args)
        (route
            :screen (homes-screen _)
        )
    )

    (def (discovery-route args)
        (route
            :screen (discovery-screen _)
        )
    )

    (def (add-home-route args)
        (overlay-route
            :tag args.tag
            :screen (add-home-screen args)
            :duration 300
            :opacity 0.5
        )
    )

    (def (edit-home-route args)
        (overlay-route
            :tag args.tag
            :screen (edit-home-screen args)
            :duration 300
            :opacity 0.5
        )
    )

    (def (main args)
        (app
            :seed-color (?? args.seed-color "#007bff")
            :dynamic-scheme-variant (?? args.dynamic-scheme-variant dynamic-scheme-variant.content)
            :visual-density args.visual-density
            :routes (
                :index homes-route
                :home home-route
                :discovery discovery-route
                :add-home add-home-route
                :edit-home edit-home-route
            )
        )
    )
)
