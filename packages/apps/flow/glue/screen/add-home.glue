(module screen.add-home
    (export add-home-screen)

    (import i18n.dict)

    (import lib.home)
    (import lib.i18n)
    (import lib.navigation)

    (import widget.modal)

    (def (txt-field-border props)
        (outline-input-border
            :border-radius (border-radius-circular 12.0)
            :border-side (border-side
                :color props.color
            )
        )
    )

    (def (txt-field props)
        (text-field
            :decoration (input-decoration
                :filled true
                :label-text props.label
                :focused-border (txt-field-border
                    :color current-theme.color-scheme.primary
                )
                :enabled-border (txt-field-border
                    :color current-theme.color-scheme.outline
                )
            )
            :on-changed (write props.state)
        )
    )

    (def (submit-home host name id)
        (\ ()
            (def home (:id id :name name :host host))
            (add-home home)
            (pop _)
        )
    )

    (def (submit-button host name id)
        (filled-button
            :child (text
                :text (select-locale i18n-add)
            )
            :on-pressed (?> (submit-home host name) id)
        )
    )

    (def (add-home-screen props)
        (def home-id (local-state _))
        (def home-name (local-state _))
        (def home-host (local-state _))
        (modal
            :color current-theme.color-scheme.surface-container
            :child (column
                :spacing 48
                :main-axis-size main-axis-size.min
                :children (
                    (column
                        :spacing 24
                        :children (
                            (text
                                :text (select-locale i18n-add-home)
                                :style current-theme.text-theme.title-medium
                            )
                            (txt-field
                                :label (select-locale i18n-home-id)
                                :state home-id
                            )
                            (txt-field
                                :label (select-locale i18n-name)
                                :state home-name
                            )
                            (txt-field
                                :label (select-locale i18n-host)
                                :state home-host
                            )
                        )
                    )
                    (row
                        :main-axis-alignment main-axis-alignment.space-around
                        :children (
                            (outlined-button
                                :child (text
                                    :text (select-locale i18n-cancel)
                                )
                                :on-pressed back
                            )
                            (listen submit-button home-host home-name home-id)
                        )
                    )
                )
            )
        )
    )
)
