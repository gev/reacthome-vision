(module screen.discovery
    (export discovery-screen)

    (import i18n.dict)

    (import lib.home)
    (import lib.i18n)
    (import lib.navigation)

    (import widget.my-homes)
    (import widget.welcome)
    (import widget.screen)

    (def (show homes)
        (if (empty? homes)
            (welcome _)
            (my-homes homes)
        )
    )

    (def (discovery-screen props)
        (screen
            :body (listen-homes show)
        )
    )
)
