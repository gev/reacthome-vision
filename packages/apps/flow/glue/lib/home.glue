(module lib.home
    (export
        find-home
        add-home
        update-home
        remove-home
        listen-homes
    )

    (import lib.entity)

    (def my-homes
        (local-persistent-state 'my-homes)
    )

    (def (modify-homes handle)
        (modify my-homes
            (\ (homes)
                (handle (?? homes ()))
            )
        )
    )

    (def (find-home home)
        (find-entity home (read my-homes))
    )

    (def (add-home home)
        (modify-homes (add-entity home))
    )

    (def (update-home home)
        (modify-homes (update-entity home))
    )

    (def (remove-home home)
        (modify-homes (remove-entity home))
    )

    (def (listen-homes handle)
        (listen handle my-homes)
    )
)
