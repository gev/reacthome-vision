(module lib.home
    (export
        add-home
        update-home
        remove-home
        listen-homes
    )

    (import lib.entity)

    (def all-homes
        (local-persistent-state 'all-homes)
    )

    (def (modify-homes handle)
        (modify all-homes
            (\ (homes)
                (handle (?? homes ()))
            )
        )
    )

    (def (add-home home)
        (modify-homes (add-entity home))
    )

    (def (update-home home)
        (modify-homes (update-entity home))
    )

    (def (remove-home home)
        (modify-homes (remove-entity home))
    )

    (def (listen-homes handle)
        (listen handle all-homes)
    )
)
