(module lib.home
    (export
        add-home
        update-home
        remove-home
        listen-homes
    )

    (def all-homes
        (local-persistent-state 'all-homes)
    )

    (def (same? home1 home2)
        (== home1.id home2.id)
    )

    (def (not-same? home1 home2)
        (!= home1.id home2.id)
    )

    (def (contains? homes home)
        (exists? (find (same? home) homes))
    )

    (def (replace dst src)
        (if (same? dst src) dst src)
    )

    (def (update homes home)
        (map (replace home) homes)
    )

    (def (remove homes home)
        (filter (not-same? home) homes)
    )

    (def (get-homes homes)
        (?? (read homes) ())
    )

    (def (add-home home)
        (def old-homes (get-homes all-homes))
        (def new-homes
            (if (contains? old-homes home)
                (update old-homes home)
                (append old-homes home)
            )
        )
        (write all-homes new-homes)
    )

    (def (update-home home)
        (def old-homes (get-homes all-homes))
        (def new-homes (update old-homes home))
        (write all-homes new-homes)
    )

    (def (remove-home home)
        (def old-homes (get-homes all-homes))
        (def new-homes (remove old-homes home))
        (write all-homes new-homes)
    )

    (def (listen-homes handle)
        (listen handle all-homes)
    )
)
