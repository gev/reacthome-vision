(module lib.entity
    (export
        same?
        not-same?
        contains?
        replace
        update
        remove
    )

    (def (same? entity1 entity2)
        (== entity1.id entity2.id)
    )

    (def (not-same? entity1 entity2)
        (!= entity1.id entity2.id)
    )

    (def (replace dst src)
        (if (same? dst src) dst src)
    )

    (def (contains? entity collection)
        (exists? (find (same? entity) collection))
    )

    (def (update entity collection)
        (map (replace entity) collection)
    )

    (def (add entity collection)
        (if (contains? collection entity)
            (update collection entity)
            (append collection entity)
        )
    )

    (def (remove entity collection)
        (filter (not-same? entity) collection)
    )
)
