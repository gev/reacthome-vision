(module widget.my-homes
    (export my-homes)

    (import i18n.dict)

    (import lib.i18n)
    (import lib.navigation)

    (import widget.section)
    (import widget.home-tile)

    (def (title props)
        (section
            :child (column
                :cross-axis-alignment cross-axis-alignment.start
                :children (
                    (logo :width 64)
                    (text
                        :text (select-locale i18n-my-homes)
                        :style current-theme.text-theme.display-medium
                    )
                )
            )
        )
    )

    (def (tile home)
        (home-tile
            :on-tap (go :route 'home :home home)
            :on-long-press (go :route 'edit-home :home home :tag home.id)
            :title home.name
            :subtitle home.id
            :trailing "arrow_forward_ios"
        )
    )

    (def (home-list homes)
        (column
            :cross-axis-alignment cross-axis-alignment.start
            :children (map tile homes)
        )
    )

    (def (add-home-button props)
        (section
            :child (elevated-button
                :child (text :text (select-locale i18n-add-home))
                :on-pressed (go :route 'discovery)
            )
        )
    )

    (def (my-homes homes)
        (column
            :cross-axis-alignment cross-axis-alignment.start
            :children (
                (sized-box :height 48)
                (title _)
                (home-list homes)
                (add-home-button _)
            )
        )
    )
)
