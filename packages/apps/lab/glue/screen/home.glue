(module screen.home
    (export home-screen)

    (import iconics)
    (import state.home)
    (import widget.iconic)

    (def (show s i)
        (iconic
            :key i
            :icon i
            :size s
        )
    )

    (def (layout size)
        (def spacing (/ size 2))
        (column
            :children (
                (slider
                    :min min-icon-size
                    :max max-icon-size
                    :value size
                    :on-changed (\ (s) (write icon-size s))
                )
                (wrap
                    :spacing spacing
                    :run-spacing spacing
                    :children (map (show size) iconics)
                )
            )
        )
    )

    (def (home-screen props)
        (scaffold
            (app-bar
                :title (text :content (@ props.title locale.language-code))
            )
            :body (single-child-scroll-view
                :child (container
                    :padding (edge-insets-symmetric :horizontal 16)
                    :width media-query.width
                    :child (listen icon-size layout)
                )
            )
        )
    )
)
