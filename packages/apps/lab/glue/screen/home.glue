(module screen.home
    (export home-screen)

    (import iconic.curtain)
    (import iconic.heater)
    (import iconic.light)
    (import iconic.sign)

    (import widget.iconic)

    (def min 32)
    (def max 256)

    (def size (state 120))

    (def iconics (
            'iconic-curtain
            'iconic-heater
            'iconic-lamp
            'iconic-cross
            'iconic-plus
        ))

    (def (show s i)
        (iconic
            :icon i
            :size s
        )
    )

    (def (layout size')
        (def spacing (/ size' 2))
        (column
            :children (
                (slider
                    :min min
                    :max max
                    :value size'
                    :on-changed (\ (s) (write size s))
                )
                (wrap
                    :spacing spacing
                    :run-spacing spacing
                    :children (map (show size') iconics)
                )
            )
        )
    )

    (def (home-screen props)
        (scaffold
            :app-bar (app-bar
                :title (text :content props.title)
            )
            :body (single-child-scroll-view
                :child (container
                    :padding (edge-insets-symmetric :horizontal 16)
                    :width media-query.width
                    :child (listen size layout)
                )
            )
        )
    )
)
