(module iconics
    (export iconics)

    (import iconic.arrow)
    (import iconic.bar)
    (import iconic.curtain)
    (import iconic.heater)
    (import iconic.light)
    (import iconic.sign)

    (def iconics (#
            iconic-right-arrow
            iconic-left-arrow
            iconic-up-arrow
            iconic-down-arrow

            iconic-horizontal-bar
            iconic-vertical-bar

            iconic-curtain
            iconic-heater
            iconic-lamp
            
            iconic-cross
            iconic-plus
        ))

)
