(module iconics
    (export iconics)

    (import iconic.curtain)
    (import iconic.heater)
    (import iconic.light)
    (import iconic.sign)
    (import iconic.arrow)
    (import iconic.bar)

    (def iconics (#
            iconic-curtain
            iconic-heater
            iconic-lamp
            iconic-cross
            iconic-plus
