(module main
    (export main)

    (import screen.home)

    (def (home-route args)
        (route
            (home-screen
                :title (
                    :en "Iconic Lab"
                    :ru "Иконичная Лаба"
                )
            )
        )
    )

    (def main
        (app
            :routes (
                :home home-route
            )
        )
    )
)
